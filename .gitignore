.docker/
pgdata/
db/data/
*.dump
*.sql.gz

# ---- n8n (added in Task 2) ----
.n8n/
n8n_data/

# ---- Task 3: generated audio + probe artefacts ----
src/audioapp/storage/
!src/audioapp/storage/.gitkeep
*.wav
*.mp3
*.m4a
*.ogg
*.webm
!tests/fixtures/**/*.wav

# ---- Pipeline output (regenerated by `make run`; never a source of truth) ----
data/staging/
data/output/
reports/
*.log

# NOTE: data/raw/*.csv is deliberately NOT ignored.
# The three source CSVs are committed verbatim and are the project's raw layer.

