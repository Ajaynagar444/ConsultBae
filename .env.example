# Copy to .env and fill in real values. .env is git-ignored; never commit it.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL
#
# Primary setup is a natively installed PostgreSQL server on port 5432.
# docker-compose.yml is the optional portable path and publishes 5433 instead,
# so it can run side by side with a native server without a port clash.
# If you use the container, change POSTGRES_PORT to 5433 below.
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=consultbae
POSTGRES_USER=consultbae
POSTGRES_PASSWORD=change-me

# Full DSN used by the pipeline and the audio app.
# Must stay consistent with the five variables above.
DATABASE_URL=postgresql://consultbae:change-me@localhost:5432/consultbae

# Separate database used by the pytest suite. Created and dropped by the tests;
# point it at a throwaway DB, never at the one holding real data.
TEST_DATABASE_URL=postgresql://consultbae:change-me@localhost:5432/consultbae_test

# ---------------------------------------------------------------------------
# Pipeline (Task 1)
# ---------------------------------------------------------------------------
RAW_DATA_DIR=data/raw
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Audio app (Task 3) - not implemented yet, placeholders reserved
# ---------------------------------------------------------------------------
AUDIOAPP_HOST=127.0.0.1
AUDIOAPP_PORT=5000
# Where uploaded/recorded audio is written. Swap for an S3 prefix later.
MEDIA_ROOT=src/audioapp/storage
MAX_UPLOAD_BYTES=26214400
# Absolute paths only needed if ffmpeg/ffprobe are not on PATH.
FFPROBE_BIN=ffprobe
FFMPEG_BIN=ffmpeg

# ---------------------------------------------------------------------------
# Automation (Task 2) - n8n is added to docker-compose in Task 2
# ---------------------------------------------------------------------------
# Shared secret the n8n webhook presents to this project's endpoints.
N8N_WEBHOOK_SECRET=change-me
